# Copy outside the repository, e.g. /etc/gesplaft/test.env (chmod 600).
NODE_ENV=production
HOST=127.0.0.1
PORT=8094
PUBLIC_ORIGIN=https://pruebas.sigxia.com.ar
DATABASE_URL=postgresql://gesplaft_test:REPLACE_WITH_LOCAL_SECRET@127.0.0.1:5432/gesplaft_test
# Enable only with the provided loopback Nginx configuration.
TRUST_PROXY=1
# Sites only: configure this as a server-side variable for first bootstrap.
# FIRST_SUPERADMIN_EMAIL=owner@example.com
